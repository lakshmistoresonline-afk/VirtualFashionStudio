# GEMINI_API_KEY: Required for Gemini AI API calls (Vision, Scripting, TTS, Analysis).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AI Execution Mode: "live" (calls Gemini/providers) or "mock" (offline testing mode)
AI_MODE="live"

# Provider Abstraction Configurations
TEXT_PROVIDER="gemini"
IMAGE_PROVIDER="gemini"
VIDEO_PROVIDER="veo"
TTS_PROVIDER="gemini"
TRANSLATION_PROVIDER="gemini"

# Optional External API Keys (for future third-party failovers)
RUNWAY_API_KEY=""
ELEVENLABS_API_KEY=""
FIREBASE_PROJECT_ID=""

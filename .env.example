# GEMINI_API_KEY: Required for Gemini AI API calls (Vision, Scripting, TTS, Analysis).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AI Execution Mode: "live" (Sim), "mock" (Fast), or "real_ai" (GPU)
AI_MODE="live"

# Remote GPU Worker Configuration (Required for Real AI Mode)
# Target: notebooka19b8802ce
GPU_WORKER_URL="http://localhost:5000"
WORKER_AUTH_TOKEN="REPLACE_WITH_SECURE_TOKEN_ON_DEPLOY"

# Provider Abstraction Configurations
TEXT_PROVIDER="gemini"
IMAGE_PROVIDER="gemini"
VIDEO_PROVIDER="veo"
TTS_PROVIDER="gemini"
TRANSLATION_PROVIDER="gemini"

# Optional External API Keys (for future third-party failovers)
RUNWAY_API_KEY=""
ELEVENLABS_API_KEY=""
FIREBASE_PROJECT_ID=""
